# Variables de entorno para el backend (server.js).
# Copia este archivo a .env con valores reales o configura estas
# variables en tu proveedor de hosting. NUNCA subas .env a git.

# URL pública de tu proyecto Supabase (no es secreta).
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Connection string de Postgres de Supabase (para `npm run db:migrate`).
# La encuentras en Supabase > Settings > Database > Connection string
# (formato postgresql://postgres.XXXX:contraseña@aws-0-XXX.pooler.supabase.com:5432/postgres).
# Si está definida, npm start aplica supabase-schema.sql automáticamente
# antes de arrancar el servidor; si no, la migración se omite.
DATABASE_URL=

# ID del proyecto Supabase (se usa solo con el Supabase CLI, opcional).
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxx

# Service role key de Supabase (SECRETA). El backend la usa para
# leer/escribir notas y saltarse la RLS del cliente público.
# NO uses aquí la anon/publishable key (esa va en el cliente).
SUPABASE_SERVICE_ROLE_KEY=

# API key del proveedor externo de posiciones (SECRETA).
FOOTBALL_DATA_API_KEY=

# API key de API-Football/H-API-Sports (SECRETA). Necesaria para los fixtures
# de la Liga Promérica (Costa Rica), que football-data.org no cubre. Se obtiene
# en api-football.com. Si no está definida, /api/fixtures/promerica responde 500.
API_FOOTBALL_KEY=

# Contraseña compartida para el acceso de redacción (SECRETA).
# Se valida en POST /api/auth.
WRITER_PASSWORD=

# Puerto del servidor Express (opcional; por defecto 3000).
PORT=3000

# ---- Autopublicación en X (opcional, apagada por defecto) ----
# Pon "true" solo cuando tengas las 4 credenciales configuradas.
# Se publica en la cuenta @Tribuna automáticamente cuando una nota
# pasa a "publicada" + "urgent" y aún no se había enviado. Costo
# aprox. $0.20 por post con enlace (pay-per-use de X, sin suscripción).
X_AUTOPOST_ENABLED=false

# Credenciales de la X API (OAuth 1.0a, User Context). SECRETAS.
# Se obtienen en developer.x.com: Project/App + autorizar la cuenta.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=